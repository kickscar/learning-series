# Kubernetes Core 실습 클러스터: control-plane 1 + worker 2 (VirtualBox)
#
# box는 bento/rockylinux-9 202510.26.0 (Rocky Linux 9.6)을 이 저장소의 GitHub 릴리스로 재배포한 것이다.
# 호스트 CPU에 맞는 box(arm64 · amd64)를 받고 체크섬으로 검증한다.

BOX_VERSION = "202510.26.0"
BOX_RELEASE = "https://github.com/kickscar/learning-series/releases/download/vagrant-rockylinux-9-#{BOX_VERSION}"
BOX_SHA256 = {
  "arm64" => "5d01857ae369808294a7047e258a9ba7ec705f6f29d36f4d56c3ff5433978e74",
  "amd64" => "51a194628a13c60db8e3b2ee58a6ff23f5959c79bb50bd68150d91e7eb1806aa",
}
ARCH = RbConfig::CONFIG["host_cpu"] =~ /arm|aarch64/ ? "arm64" : "amd64"

NODES = [
  { name: "cp",      ip: "192.168.56.10", cpus: 2, memory: 2560 },
  { name: "worker1", ip: "192.168.56.11", cpus: 2, memory: 3072 },
  { name: "worker2", ip: "192.168.56.12", cpus: 2, memory: 3072 },
]

Vagrant.configure("2") do |config|
  config.vm.box = "learning-series/rockylinux-9-#{ARCH}"
  config.vm.box_url = "#{BOX_RELEASE}/rockylinux-9-#{BOX_VERSION}-virtualbox-#{ARCH}.box"
  config.vm.box_download_checksum_type = "sha256"
  config.vm.box_download_checksum = BOX_SHA256[ARCH]
  config.vm.synced_folder ".", "/vagrant", disabled: true
  # box가 지정한 NAT 어댑터 MAC를 쓰지 않는다. linked clone 노드마다 MAC가 달라진다
  config.vm.base_mac = nil

  NODES.each do |node|
    config.vm.define node[:name] do |n|
      n.vm.hostname = node[:name]
      # NIC1: NAT (외부 다운로드), NIC2: host-only (클러스터 통신)
      n.vm.network "private_network", ip: node[:ip]
      n.vm.provider "virtualbox" do |vb|
        vb.name = "kc-#{node[:name]}"
        vb.cpus = node[:cpus]
        vb.memory = node[:memory]
        vb.linked_clone = true
      end
    end
  end
end
